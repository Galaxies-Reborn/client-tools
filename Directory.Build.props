<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Keep command-line project builds deterministic while allowing callers to
       select either Win32 or x64 explicitly. -->
  <PropertyGroup>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <SwgAudioBackend Condition="'$(SwgAudioBackend)' == ''">Juce</SwgAudioBackend>
    <SwgWritableOutputRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..\_whitengold_client'))</SwgWritableOutputRoot>
    <SwgExternalOutputRoot Condition="'$(SwgExternalOutputRoot)' == ''">$(SwgWritableOutputRoot)build\tcg-reborn</SwgExternalOutputRoot>
    <SwgNormalizedExternalOutputRoot Condition="'$(SwgExternalOutputRoot)' != ''">$([MSBuild]::NormalizeDirectory('$(SwgExternalOutputRoot)'))</SwgNormalizedExternalOutputRoot>
    <BaseIntermediateOutputPath Condition="'$(SwgExternalOutputRoot)' != ''">$(SwgExternalOutputRoot)\project-extensions\$(Platform)\$(Configuration)\$(SwgAudioBackend)\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath Condition="'$(SwgExternalOutputRoot)' != ''">$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <SwgRuntimeArchitecture Condition="'$(Platform)' == 'Win32'">win32</SwgRuntimeArchitecture>
    <SwgRuntimeArchitecture Condition="'$(Platform)' == 'x64'">x64</SwgRuntimeArchitecture>
    <SwgConfigurationLower>$([System.String]::Copy('$(Configuration)').ToLowerInvariant())</SwgConfigurationLower>
    <SwgAudioBackendLower>$([System.String]::Copy('$(SwgAudioBackend)').ToLowerInvariant())</SwgAudioBackendLower>
    <SwgRuntimeRoot Condition="'$(SwgRuntimeRoot)' == '' and '$(SwgRuntimeArchitecture)' != ''">$(SwgWritableOutputRoot)runtime\$(SwgRuntimeArchitecture)-dx11-$(SwgConfigurationLower)-$(SwgAudioBackendLower)</SwgRuntimeRoot>
    <ForceImportBeforeCppTargets>$(MSBuildThisFileDirectory)scripts\SwgExternalOutput.props</ForceImportBeforeCppTargets>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <SwgDependenciesDir>$(MSBuildThisFileDirectory)deps\x64</SwgDependenciesDir>
    <SwgX64DependenciesDir>$(SwgDependenciesDir)</SwgX64DependenciesDir>
    <SwgCompatibilityDependencies>swg-stubs.lib;vivoxSharedWrapper.lib;libxml2.lib;pcre.lib;</SwgCompatibilityDependencies>
    <SwgAudioBackendDependencies Condition="'$(SwgAudioBackend)' == 'Miles'">mss64.lib;</SwgAudioBackendDependencies>
    <SwgPlatformLibraryDirectories>$(DXSDK_DIR)Lib\x64;$(WindowsSDK_LibraryPath_x64);$(SwgDependenciesDir)\lib;$(MSBuildThisFileDirectory)mss64-stub;</SwgPlatformLibraryDirectories>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'Win32'">
    <SwgDependenciesDir>$(MSBuildThisFileDirectory)deps\win32</SwgDependenciesDir>
    <SwgCompatibilityDependencies>vivoxSharedWrapper.lib;libxml2.lib;pcre.lib;</SwgCompatibilityDependencies>
    <SwgPlatformLibraryDirectories>$(DXSDK_DIR)Lib\x86;$(WindowsSDK_LibraryPath_x86);$(SwgDependenciesDir)\lib;</SwgPlatformLibraryDirectories>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Platform)' == 'x64'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(TargetDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_HAS_AUTO_PTR_ETC=1;_SILENCE_STDEXT_HASH_DEPRECATION_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)' == 'Win32'">
    <ClCompile>
      <PreprocessorDefinitions>_HAS_AUTO_PTR_ETC=1;_SILENCE_STDEXT_HASH_DEPRECATION_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(MSBuildThisFileDirectory)src\external\3rd\library\stlport453\lib\win32;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)' == 'Win32' and ('$(MSBuildProjectName)' == 'Direct3d9' or '$(MSBuildProjectName)' == 'Direct3d9_ffp' or '$(MSBuildProjectName)' == 'Direct3d9_vsps')">
    <ClCompile>
      <AdditionalIncludeDirectories>$(DXSDK_DIR)Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <!-- Use the SDK's explicit x86 library path.  The legacy renderer
           projects also search the repository's x64 dependency directory,
           where a bare DxErr.lib name resolves to the wrong machine type. -->
      <AdditionalDependencies>$(DXSDK_DIR)Lib\x86\DxErr.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
